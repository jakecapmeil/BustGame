# Repo-root files that are not part of the deployed site.
# Everything else (index.html, styles.css, sw.js, manifest, src/, assets/) ships.
**/node_modules
**/.DS_Store
**/.git
# wrangler's own scratch dir. Without this its temp deploy artifacts (a
# no-op-worker source map, local dev state) ship as public site assets.
.wrangler
.claude
test
package.json
package-lock.json
wrangler.jsonc
.assetsignore
.gitignore
*.md
